# ---- Large data & model artifacts (regenerate via the pipeline) ----
# Tokenized binary caches and splits
*.bin
*.idx
tokenizer/cache/
tokenizer/data/
# Trained tokenizer model (large; produced by tokenizer/train_tokenizer.py)
*.model
# Checkpoints (produced by training)
*.pt
*.pth
*.ckpt
*.safetensors
cyberslm/checkpoints/
cyberslm_sft/checkpoints/

# ---- Raw / intermediate corpora (large) ----
# Keep the small curated corpus under Dataset_corpus/ tracked, but ignore the
# giant merged/final jsonl artifacts that are regenerated by the pipeline.
tokenizer/Final.jsonl
cyberslm_sft/data/SFT.jsonl

# ---- Logs ----
*.log

# ---- Training run outputs (new pipeline) ----
runs/
*.out
*.err

# ---- Modal ----
.modal.toml

# ---- Final deliverable: ship the code, not the weights ----

# ---- Never publish the corpus or weights ----
# This branch is the public, code-only branch. Dataset_corpus/ is 745 MB and
# contains a 184 MB file; GitHub rejects anything over 100 MB, and it must not
# be published in any case. Listed explicitly so `git add -A` cannot pick it up.
Dataset_corpus/
runs/
*.jsonl

# ---- Local editor / OS / archives ----
.claude/
.vscode/
*.zip
tokenizer/stats.json
tokenizer/tokenizer_output/

# Local weights store (published on Hugging Face, never in git)
models/

# ---- Benchmark artifacts ----
hf_export/
bench/*/arithmark*.jsonl
bench/*/*.jsonl
